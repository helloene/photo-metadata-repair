#!/usr/bin/env bash
set -euo pipefail

script_source="${BASH_SOURCE[0]}"
while [[ -L "$script_source" ]]; do
  script_dir="$(cd "$(dirname "$script_source")" && pwd)"
  script_link="$(readlink "$script_source")"
  if [[ "$script_link" == /* ]]; then
    script_source="$script_link"
  else
    script_source="$script_dir/$script_link"
  fi
done
script_dir="$(cd "$(dirname "$script_source")" && pwd)"

usage() {
  cat <<'USAGE'
Usage:
  media-metadata-repair [options] <folder-or-file>...

Options:
  --tz +08:00                 Timezone offset to write into EXIF/XMP offset tags. Required for filename recovery.
  --gps LAT,LON               Write GPS coordinates to EXIF and XMP GPS fields.
  --set-time DATETIME         Set capture time for all inputs, then sync supported time fields.
  --set-gps LAT,LON           Set GPS coordinates for all inputs.
  --set-make MAKE             Set camera/device make for all inputs.
  --set-model MODEL           Set camera/device model for all inputs.
  --metadata-csv FILE         Set per-file metadata from CSV columns: file,time,gps,make,model.
  --dry-run                   Print actions without modifying files.
  --output-dir DIR            Write repaired copies under DIR. Default: ./media-metadata-repair-output-YYYYMMDD-HHMMSS
  --in-place                  Modify input files directly instead of working on repaired copies.
  --from-filename-if-missing  Fill missing embedded capture time from recognizable filename timestamps, after grouped sample confirmation.
  --yes                       Skip interactive confirmation for filename-derived timestamps.
  --convert-jpg-to-jxl        Losslessly transcode .jpg/.jpeg files to .jxl files after metadata repair.
  --overwrite-jxl             Overwrite existing .jxl files when converting JPEG to JPEG XL.
  --replace-jpg-with-jxl      After successful JPEG XL conversion, remove the corresponding .jpg/.jpeg file.
  --repair-mislabelled-heic   For .heic files that are actually JPEG bytes, write via a temporary JPEG copy and restore the original filename.
  --verify-sample N           Print metadata for N random files after repair.

What it does:
  - Images: choose DateTimeOriginal, then fallback to CreateDate/ModifyDate/file dates, and sync EXIF/TIFF/XMP/IPTC/file time fields.
  - Videos: choose QuickTime CreateDate, then fallback to MediaCreateDate/TrackCreateDate/file dates, and sync QuickTime/file time fields.
  - Device metadata: sync existing Make/Model across supported EXIF/TIFF/XMP/QuickTime fields.
  - Optional manual metadata: set global or per-file time/GPS/make/model.
  - By default: copy supported files to an output directory and repair those copies.
  - Optional JPEG XL: losslessly transcode repaired JPEG files to .jxl.
  - Optional filename recovery: write missing embedded capture time from unambiguous filename timestamps.
  - Optional GPS: write latitude/longitude to EXIF GPS and XMP-exif GPS fields.
  - Optional timezone: write OffsetTime/OffsetTimeOriginal/OffsetTimeDigitized.
USAGE
}

tz=""
tz_provided=0
gps=""
set_time=""
set_gps=""
set_make=""
set_model=""
metadata_csv=""
dry_run=0
output_dir=""
in_place=0
from_filename_if_missing=0
assume_yes=0
convert_jpg_to_jxl=0
overwrite_jxl=0
replace_jpg_with_jxl=0
repair_mislabelled_heic=0
verify_sample=0
paths=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --tz)
      tz="${2:?missing timezone value}"
      tz_provided=1
      shift 2
      ;;
    --gps)
      gps="${2:?missing GPS value LAT,LON}"
      shift 2
      ;;
    --set-time)
      set_time="${2:?missing time value}"
      shift 2
      ;;
    --set-gps)
      set_gps="${2:?missing GPS value LAT,LON}"
      gps="$set_gps"
      shift 2
      ;;
    --set-make)
      set_make="${2:?missing make value}"
      shift 2
      ;;
    --set-model)
      set_model="${2:?missing model value}"
      shift 2
      ;;
    --metadata-csv)
      metadata_csv="${2:?missing metadata CSV file}"
      shift 2
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --output-dir)
      output_dir="${2:?missing output directory}"
      shift 2
      ;;
    --in-place)
      in_place=1
      shift
      ;;
    --from-filename-if-missing)
      from_filename_if_missing=1
      shift
      ;;
    --yes|-y)
      assume_yes=1
      shift
      ;;
    --convert-jpg-to-jxl|--jpg-to-jxl)
      convert_jpg_to_jxl=1
      shift
      ;;
    --overwrite-jxl)
      overwrite_jxl=1
      shift
      ;;
    --replace-jpg-with-jxl)
      replace_jpg_with_jxl=1
      shift
      ;;
    --repair-mislabelled-heic)
      repair_mislabelled_heic=1
      shift
      ;;
    --verify-sample)
      verify_sample="${2:?missing sample count}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      paths+=("$1")
      shift
      ;;
  esac
done

if [[ ${#paths[@]} -eq 0 ]]; then
  usage
  exit 2
fi

if [[ "$replace_jpg_with_jxl" -eq 1 && "$convert_jpg_to_jxl" -eq 0 ]]; then
  echo "--replace-jpg-with-jxl requires --convert-jpg-to-jxl" >&2
  exit 2
fi

if [[ -n "$metadata_csv" && ! -f "$metadata_csv" ]]; then
  echo "Metadata CSV not found: $metadata_csv" >&2
  exit 1
fi

if [[ "$in_place" -eq 0 && -z "$output_dir" ]]; then
  output_dir="media-metadata-repair-output-$(date +%Y%m%d-%H%M%S)"
fi

if ! command -v exiftool >/dev/null 2>&1; then
  echo "exiftool is required. Install ExifTool with your platform's package manager or official installer." >&2
  exit 1
fi

if [[ "$convert_jpg_to_jxl" -eq 1 ]] && ! command -v cjxl >/dev/null 2>&1; then
  echo "cjxl is required for JPEG XL conversion. Install JPEG XL tools with your platform's package manager." >&2
  exit 1
fi

run() {
  if [[ "$dry_run" -eq 1 ]]; then
    printf 'DRY RUN:'
    printf ' %q' "$@"
    printf '\n'
  else
    "$@"
  fi
}

run_optional_match() {
  if [[ "$dry_run" -eq 1 ]]; then
    printf 'DRY RUN:'
    printf ' %q' "$@"
    printf '\n'
  else
    "$@" || true
  fi
}

if [[ "$in_place" -eq 0 ]]; then
  prepared_paths_file="$(mktemp)"
  ruby "$script_dir/scripts/prepare_workspace.rb" "$dry_run" "$output_dir" "${paths[@]}" > "$prepared_paths_file"

  prepared_paths=()
  while IFS= read -r prepared_path; do
    [[ -n "$prepared_path" ]] && prepared_paths+=("$prepared_path")
  done < "$prepared_paths_file"
  rm -f "$prepared_paths_file"

  if [[ ${#prepared_paths[@]} -eq 0 ]]; then
    echo "No supported media files found to prepare." >&2
    exit 1
  fi

  if [[ "$dry_run" -eq 0 ]]; then
    echo "Prepared repaired-copy workspace: $output_dir"
  else
    echo "Dry run: would prepare repaired-copy workspace: $output_dir"
  fi
  paths=("${prepared_paths[@]}")
fi

image_gps_args=()
video_gps_args=()
image_tz_args=()
if [[ -n "$gps" ]]; then
  lat="${gps%,*}"
  lon="${gps#*,}"
  lat_ref="N"
  lon_ref="E"
  [[ "$lat" == -* ]] && lat_ref="S"
  [[ "$lon" == -* ]] && lon_ref="W"
  image_gps_args=(
    "-GPSLatitude=$lat"
    "-GPSLongitude=$lon"
    "-GPSLatitudeRef=$lat_ref"
    "-GPSLongitudeRef=$lon_ref"
    "-XMP-exif:GPSLatitude=$lat"
    "-XMP-exif:GPSLongitude=$lon"
  )
  video_gps_args=(
    "-Keys:GPSCoordinates=$lat, $lon"
    "-UserData:GPSCoordinates=$lat, $lon"
  )
fi
if [[ "$tz_provided" -eq 1 ]]; then
  image_tz_args=(
    "-OffsetTime=$tz"
    "-OffsetTimeOriginal=$tz"
    "-OffsetTimeDigitized=$tz"
  )
fi

common_exts=(-ext jpg -ext jpeg -ext heic -ext png -ext tif -ext tiff -ext mp4 -ext mov -ext m4v -ext 3gp)
image_exts=(-ext jpg -ext jpeg -ext heic -ext png -ext tif -ext tiff)
video_exts=(-ext mp4 -ext mov -ext m4v -ext 3gp)
if [[ "$repair_mislabelled_heic" -eq 1 ]]; then
  image_exts=(-ext jpg -ext jpeg -ext png -ext tif -ext tiff)
fi

has_image_targets() {
  if [[ "$repair_mislabelled_heic" -eq 1 ]]; then
    find "${paths[@]}" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.tif' -o -iname '*.tiff' \) -print -quit 2>/dev/null | grep -q .
  else
    find "${paths[@]}" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.heic' -o -iname '*.png' -o -iname '*.tif' -o -iname '*.tiff' \) -print -quit 2>/dev/null | grep -q .
  fi
}

has_video_targets() {
  find "${paths[@]}" -type f \( -iname '*.mp4' -o -iname '*.mov' -o -iname '*.m4v' -o -iname '*.3gp' \) -print -quit 2>/dev/null | grep -q .
}

if [[ "$repair_mislabelled_heic" -eq 1 ]]; then
  echo "Repairing mislabelled HEIC files that are JPEG data..."
  if [[ "$dry_run" -eq 1 ]]; then
    find "${paths[@]}" -type f -iname '*.heic' -print 2>/dev/null \
      | while IFS= read -r file; do
          if file "$file" | grep -qi 'jpeg'; then
            printf 'DRY RUN: repair JPEG data in HEIC path %q via temporary .jpg\n' "$file"
          fi
        done
  else
    find "${paths[@]}" -type f -iname '*.heic' -print 2>/dev/null \
      | while IFS= read -r file; do
          [[ -f "$file" ]] || continue
          if file "$file" | grep -qi 'jpeg'; then
            tmp="${file%/*}/.$(basename "$file").tmp.jpg"
            cp "$file" "$tmp"
            exiftool -P -overwrite_original -m \
              "-DateTimeOriginal<DateTimeOriginal" \
              "-CreateDate<DateTimeOriginal" \
              "-ModifyDate<DateTimeOriginal" \
              "-XMP:DateCreated<DateTimeOriginal" \
              "-XMP:CreateDate<DateTimeOriginal" \
              "-XMP-photoshop:DateCreated<DateTimeOriginal" \
              "-IPTC:DateCreated<DateTimeOriginal" \
              "-IPTC:TimeCreated<DateTimeOriginal" \
              "${image_tz_args[@]}" \
              "-FileModifyDate<DateTimeOriginal" \
              "-FileCreateDate<DateTimeOriginal" \
              "${image_gps_args[@]}" \
              "$tmp" >/dev/null && mv "$tmp" "$file" || rm -f "$tmp"
          fi
        done
  fi
fi

if [[ "$from_filename_if_missing" -eq 1 ]]; then
  ruby "$script_dir/scripts/filename_recovery.rb" "$tz" "$tz_provided" "$dry_run" "$assume_yes" "${paths[@]}"
fi

if [[ -n "$set_time" || -n "$set_gps" || -n "$set_make" || -n "$set_model" || -n "$metadata_csv" ]]; then
  echo "Applying manual metadata..."
  ruby "$script_dir/scripts/manual_metadata.rb" "$dry_run" "$tz" "$set_time" "$set_gps" "$set_make" "$set_model" "$metadata_csv" "${paths[@]}"
fi

echo "Synchronizing device make/model metadata..."
if [[ "$dry_run" -eq 1 ]]; then
  echo "DRY RUN: scan existing Make/Model fields, skip conflicting fields, and write non-conflicting values across supported EXIF/TIFF/XMP/QuickTime fields"
else
  run ruby "$script_dir/scripts/sync_make_model.rb" "${paths[@]}"
fi

if [[ -z "$gps" && -z "$metadata_csv" ]]; then
  echo "Synchronizing GPS metadata where non-conflicting..."
  if [[ "$dry_run" -eq 1 ]]; then
    echo "DRY RUN: scan existing GPS fields, skip conflicts, and write missing non-conflicting GPS counterparts"
  else
    run ruby "$script_dir/scripts/sync_gps.rb" "${paths[@]}"
  fi
fi

if has_image_targets; then
  echo "Filling missing image capture time from fallback metadata..."
  run_optional_match exiftool -r -P -overwrite_original -m \
    "${image_exts[@]}" \
    -if 'not $DateTimeOriginal and $CreateDate' \
    "-DateTimeOriginal<CreateDate" \
    "${paths[@]}"

  run_optional_match exiftool -r -P -overwrite_original -m \
    "${image_exts[@]}" \
    -if 'not $DateTimeOriginal and $ModifyDate' \
    "-DateTimeOriginal<ModifyDate" \
    "${paths[@]}"

  run_optional_match exiftool -r -P -overwrite_original -m \
    "${image_exts[@]}" \
    -if 'not $DateTimeOriginal and $FileCreateDate' \
    "-DateTimeOriginal<FileCreateDate" \
    "${paths[@]}"

  run_optional_match exiftool -r -P -overwrite_original -m \
    "${image_exts[@]}" \
    -if 'not $DateTimeOriginal and $FileModifyDate' \
    "-DateTimeOriginal<FileModifyDate" \
    "${paths[@]}"

  echo "Repairing image metadata..."
  run exiftool -r -P -overwrite_original -m -api QuickTimeUTC=1 \
    "${image_exts[@]}" \
    "-DateTimeOriginal<DateTimeOriginal" \
    "-CreateDate<DateTimeOriginal" \
    "-ModifyDate<DateTimeOriginal" \
    "-XMP:DateCreated<DateTimeOriginal" \
    "-XMP:CreateDate<DateTimeOriginal" \
    "-XMP-photoshop:DateCreated<DateTimeOriginal" \
    "-IPTC:DateCreated<DateTimeOriginal" \
    "-IPTC:TimeCreated<DateTimeOriginal" \
    "${image_tz_args[@]}" \
    "-FileModifyDate<DateTimeOriginal" \
    "-FileCreateDate<DateTimeOriginal" \
    "${image_gps_args[@]}" \
    "${paths[@]}"

  if [[ "$tz_provided" -eq 0 ]]; then
    echo "Synchronizing image timezone offsets from existing EXIF/XMP offset tags..."
    run_optional_match exiftool -r -P -overwrite_original -m \
      "${image_exts[@]}" \
      -if '$OffsetTimeOriginal' \
      "-OffsetTime<OffsetTimeOriginal" \
      "-OffsetTimeDigitized<OffsetTimeOriginal" \
      "${paths[@]}"
    run_optional_match exiftool -r -P -overwrite_original -m \
      "${image_exts[@]}" \
      -if 'not $OffsetTimeOriginal and $OffsetTime' \
      "-OffsetTimeOriginal<OffsetTime" \
      "-OffsetTimeDigitized<OffsetTime" \
      "${paths[@]}"
    run_optional_match exiftool -r -P -overwrite_original -m \
      "${image_exts[@]}" \
      -if 'not $OffsetTimeOriginal and not $OffsetTime and $OffsetTimeDigitized' \
      "-OffsetTime<OffsetTimeDigitized" \
      "-OffsetTimeOriginal<OffsetTimeDigitized" \
      "${paths[@]}"
  fi
fi

if has_video_targets; then
  echo "Filling missing video creation time from fallback metadata..."
  run_optional_match exiftool -r -P -overwrite_original -m -api QuickTimeUTC=1 \
    "${video_exts[@]}" \
    -if 'not $QuickTime:CreateDate and $QuickTime:MediaCreateDate' \
    "-QuickTime:CreateDate<QuickTime:MediaCreateDate" \
    "${paths[@]}"

  run_optional_match exiftool -r -P -overwrite_original -m -api QuickTimeUTC=1 \
    "${video_exts[@]}" \
    -if 'not $QuickTime:CreateDate and $QuickTime:TrackCreateDate' \
    "-QuickTime:CreateDate<QuickTime:TrackCreateDate" \
    "${paths[@]}"

  run_optional_match exiftool -r -P -overwrite_original -m -api QuickTimeUTC=1 \
    "${video_exts[@]}" \
    -if 'not $QuickTime:CreateDate and $FileCreateDate' \
    -d '%Y:%m:%d %H:%M:%S' \
    "-QuickTime:CreateDate<FileCreateDate" \
    "${paths[@]}"

  run_optional_match exiftool -r -P -overwrite_original -m -api QuickTimeUTC=1 \
    "${video_exts[@]}" \
    -if 'not $QuickTime:CreateDate and $FileModifyDate' \
    -d '%Y:%m:%d %H:%M:%S' \
    "-QuickTime:CreateDate<FileModifyDate" \
    "${paths[@]}"

  echo "Repairing video metadata from QuickTime CreateDate..."
  run_optional_match exiftool -r -P -overwrite_original -m -api QuickTimeUTC=1 \
    "${video_exts[@]}" \
    -if '$QuickTime:CreateDate and $QuickTime:CreateDate ne "0000:00:00 00:00:00"' \
    "-FileModifyDate<\${QuickTime:CreateDate}" \
    "-FileCreateDate<\${QuickTime:CreateDate}" \
    "-QuickTime:MediaCreateDate<\${QuickTime:CreateDate}" \
    "-QuickTime:TrackCreateDate<\${QuickTime:CreateDate}" \
    "${paths[@]}"
fi

if [[ -n "$gps" ]] && has_video_targets; then
  echo "Writing explicit video GPS metadata..."
  run exiftool -r -P -overwrite_original -m \
    "${video_exts[@]}" \
    "${video_gps_args[@]}" \
    "${paths[@]}"
fi

if [[ "$verify_sample" -gt 0 ]]; then
  echo "Verification sample:"
  find "${paths[@]}" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.heic' -o -iname '*.png' -o -iname '*.tif' -o -iname '*.tiff' -o -iname '*.mp4' -o -iname '*.mov' -o -iname '*.m4v' -o -iname '*.3gp' \) \
    | ruby -e "puts STDIN.read.lines.sample($verify_sample)" \
    | while IFS= read -r file; do
        echo "==== $file"
        exiftool -s -DateTimeOriginal -CreateDate -ModifyDate -OffsetTimeOriginal -GPSLatitude -GPSLongitude -Make -Model -QuickTime:CreateDate -QuickTime:MediaCreateDate -QuickTime:TrackCreateDate -FileModifyDate "$file"
      done
fi

if [[ "$convert_jpg_to_jxl" -eq 1 ]]; then
  echo "Converting JPEG files to lossless JPEG XL..."
  ruby "$script_dir/scripts/convert_jpg_to_jxl.rb" "$dry_run" "$overwrite_jxl" "$replace_jpg_with_jxl" "${paths[@]}"
fi
